PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qlife?schema=public

# Cognito (stateless JWT verification)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (MVP: log or SMTP)
# EMAIL_TRANSPORT=log | smtp
EMAIL_TRANSPORT=log
EMAIL_FROM=no-reply@qlife.invalid
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...

