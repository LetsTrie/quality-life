PORT=5012
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qlife?schema=public

# CORS
# - Use `*` for local dev to allow any Origin (reflected, works with credentials).
# - In production, set a comma-separated allowlist (no wildcard).
# - Also governs the WebSocket (Socket.io) gateway CORS. The Flutter mobile
#   client sends no Origin, so this only affects browser socket clients; it uses
#   the existing API_BASE_URL to reach the socket server.
CORS_ORIGINS=*

# WorkOS User Management (backend-for-frontend auth).
# API key + client id from the WorkOS dashboard. The client id also derives the
# JWKS URL used to verify access tokens. Password reset is fully in-app (WorkOS
# Magic Auth emails a one-time code) — no reset URL needed.
WORKOS_API_KEY=your_api_key_here
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxx

# Admin panel login (separate from WorkOS — self-issued HS256 token).
ADMIN_EMAIL=admin@qlife-bd.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-long-random

# Email (MVP: log or SMTP)
# EMAIL_TRANSPORT=log | smtp
EMAIL_TRANSPORT=log
EMAIL_FROM=no-reply@qlife.invalid
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...

# Firebase Cloud Messaging (Android push).
# Preferred: base64 of the service-account JSON (single line, deploy-safe):
#   base64 -i serviceAccount.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_B64=...
# Fallback (raw JSON, one line):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Local docker-compose (optional)
# DATABASE_URL=postgresql://qlife:qlife@localhost:5432/qlife?schema=public

