## Render production environment variables (example)
## Copy these keys into Render → Service → Environment.
## Do NOT commit real values.

# Supabase: use the DIRECT (non-pooler) connection string for Prisma migrations.
# IMPORTANT: if your password contains reserved URL characters (like @ or +),
# it must be URL-encoded inside DATABASE_URL (e.g. @ -> %40, + -> %2B).
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# CORS: in production, DO NOT use '*'. Use a comma-separated allowlist:
# - Vercel admin URL (and custom domain if you have one)
CORS_ORIGINS=https://<your-admin>.vercel.app

# Cognito (stateless JWT verification)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (SMTP)
EMAIL_TRANSPORT=smtp
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=...
SMTP_PASS=...

# Admin (used for the /v1/admin/login shortcut)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<set-a-strong-password>
ADMIN_JWT_SECRET=<long-random-secret>

