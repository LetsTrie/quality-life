<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Dev-only: allow plain http:// so the app can reach a local backend
         (e.g. http://<dev-machine-LAN-IP>:3000) during development. Android 9+
         blocks cleartext by default. This lives in the DEBUG manifest only, so
         release builds stay HTTPS-only. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
